# Auth.js — https://authjs.dev/reference/nextjs
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_IDS= # ID numérico de GitHub del administrador global, separados por coma

# Linear — solo servidor, nunca expuesta al browser
LINEAR_API_KEY=
LINEAR_TEAM_KEY=MOVO
LINEAR_WEBHOOK_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_WEBHOOK_SECRET=
LINEAR_TOKEN_ENCRYPTION_KEY= # 32 bytes aleatorios codificados en base64

# Claude — solo servidor
ANTHROPIC_API_KEY=

# Admin API de Anthropic (opcional) — para ver uso/costo real en /settings/usage.
# Se crea en la consola de Anthropic (Settings > Admin API keys), es distinta de ANTHROPIC_API_KEY.
ANTHROPIC_ADMIN_API_KEY=

# Neon Postgres
DATABASE_URL=

# Control de costos del análisis (M3)
MAX_ANALYSES_PER_DAY=10
